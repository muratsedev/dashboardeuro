# Environment variables for production deployment
# Copy this file to .env.local and update the values

# API Base URL - Replace with your production API server URL
NEXT_PUBLIC_API_URL=https://your-api-server.com

# Cloud production API (default)
NEXT_PUBLIC_API_URL=https://euronews-001-site1.stempurl.com

# For local development (uncomment if you want to use local backend)
# NEXT_PUBLIC_API_URL=https://localhost:7065

# Environment
NODE_ENV=production

# Next.js build optimization
NEXT_TELEMETRY_DISABLED=1